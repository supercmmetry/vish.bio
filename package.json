{
  "name": "vish-bio",
  "version": "1.0.0",
  "description": "A minimal portfolio website",
  "repository": "https://github.com/supercmmetry/vish.bio",
  "author": "Vishaal Selvaraj <vishaals2000@gmail.com>",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.4",
    "npm-watch": "^0.13.0",
    "postcss": "^8.4.39",
    "postcss-cli": "^11.0.0",
    "rimraf": "^5.0.8",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  },
  "watch": {
    "dev": {
      "patterns": [
        "src",
        "templates",
        "styles"
      ],
      "extensions": "html,css,rs,js",
      "quiet": true,
      "legacyWatch": true,
      "delay": 300,
      "runOnChangeOnly": false
    }
  },
  "scripts": {
    "clean": "rimraf assets/app.generated.css",
    "fonts": "cp node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2 node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2 node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2 node_modules/@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2 assets/fonts/",
    "build": "NODE_ENV=production postcss styles/app.css -o assets/app.generated.css",
    "build:dev": "postcss styles/app.css -o assets/app.generated.css",
    "release": "yarn build && cargo build --release --locked",
    "dev": "yarn build:dev && cargo run",
    "start": "yarn release && ./target/release/vish-bio",
    "watch": "npm-watch"
  }
}
